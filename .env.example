# Copy to .env.local (repo root) for local runs; set the same names in Vercel → Project → Settings → Environment Variables.

# --- Supabase (sign-in + sync). Public client values; row-level security protects the data.
NEXT_PUBLIC_Noodl_NOODLSUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_Noodl_NOODLSUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- AI (server only — never prefix with NEXT_PUBLIC_). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model id from AI Studio (default gemini-3.1-flash-lite)
GEMINI_MODEL=

# --- Marketing site canonical URL (Vercel: your production domain)
NEXT_PUBLIC_SITE_URL=https://noodl.vercel.app

# --- Local dev only: the app dev server (port 3000) calls the AI function on 4320
# NEXT_PUBLIC_AI_ENDPOINT=http://localhost:4320/api/ai
# AI_ALLOWED_ORIGINS=http://localhost:3000
