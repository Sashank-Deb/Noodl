# All values are public client config (safe to expose). Leave empty to run fully
# local: no sign-in, no sync, typeahead uses your own notes only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# reCAPTCHA v3 site key registered for Firebase App Check (protects Firestore + AI)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Gemini model id from Google AI Studio (free tier). Default: gemini-3.1-flash-lite
NEXT_PUBLIC_GEMINI_MODEL=
