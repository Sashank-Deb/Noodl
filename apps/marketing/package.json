{
  "name": "marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens": "node scripts/gen-dark-tokens.mjs",
    "dev": "node scripts/gen-dark-tokens.mjs && next dev --port 3001",
    "build": "node scripts/gen-dark-tokens.mjs && next build && node scripts/postexport.mjs",
    "build:keep-js": "KEEP_NEXT_JS=1 pnpm run build",
    "serve": "npx -y serve@14 out -l 4321",
    "lint": "eslint",
    "lhci": "npx -y @lhci/cli@0.15 autorun"
  },
  "dependencies": {
    "@noodl/tokens": "workspace:*",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.0"
}
