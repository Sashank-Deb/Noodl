rules_version = '2';

// Each user can only read and write their own notes and folders.
// No other collections are readable or writable.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/notes/{noteId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.id == noteId
        && request.resource.data.rootId is string
        && request.resource.data.nodes is map
        && request.resource.data.updatedAt is number
        // Server timestamp drives incremental pulls (immune to device clock skew).
        && request.resource.data.serverUpdatedAt == request.time;
    }

    match /users/{uid}/folders/{folderId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.id == folderId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.serverUpdatedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
